# owiki 本地开发环境变量模板：cp .env.example .env 后按需修改
# .env 已被 gitignore，不会进版本库；生产部署用 docker-compose/systemd 传环境变量

# 监听地址
OWIKI_ADDR=:8787
# SQLite 数据库路径
OWIKI_DB=owiki.db

# 默认 vault 的初始同步令牌（仅首次建库时使用）
OWIKI_TOKEN=dev-token-change-me

# Web 管理端登录账户（仅首次启动初始化管理员；之后改这里不会覆盖已有账户）
OWIKI_ADMIN_USER=admin
OWIKI_ADMIN_PASSWORD=change-me
