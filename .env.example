# owiki 本地开发环境变量模板：cp .env.example .env 后按需修改
# .env 已被 gitignore，不会进版本库；生产部署用 docker-compose/systemd 传环境变量

# 监听地址
OWIKI_ADDR=:8787
# SQLite 数据库路径
OWIKI_DB=owiki.db

# 仅旧库迁移用：存在 vault_id=0 的遗留笔记时，会用这个令牌建 default vault。
# 全新部署可以不设，vault 在 Web 端新建，各自生成独立令牌。
OWIKI_TOKEN=dev-token-change-me

# Web 管理端登录账户（仅首次启动初始化管理员；之后改这里不会覆盖已有账户）
OWIKI_ADMIN_USER=admin
OWIKI_ADMIN_PASSWORD=change-me

# 内置功能的首次启动默认（空=开，off=关）。日常开关在 Web「设置 → 插件」，拨过之后这里不再覆盖。
# OWIKI_SHARE=off
# OWIKI_SYNCLOG=off
# OWIKI_APIKEYS=off
# OWIKI_MCP=off
